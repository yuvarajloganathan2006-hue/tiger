# Local model (Ollama)
TIGER_OLLAMA_URL=http://127.0.0.1:11434
TIGER_LOCAL_MODEL=qwen3:8b

# Optional OpenAI-compatible online fallback. Disabled by default.
# Check the chosen provider's current pricing and free-tier limits.
TIGER_CLOUD_FALLBACK_ENABLED=false
TIGER_CLOUD_BASE_URL=https://api.openai.com/v1
TIGER_CLOUD_MODEL=
TIGER_CLOUD_API_KEY=

# Defaults to ~/.tiger/tiger.sqlite3
TIGER_DB_PATH=
